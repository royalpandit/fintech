# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
#
#   cp apps/admin/.env.example apps/admin/.env
#
# Restart the dev server after editing: Next.js reads .env once at boot.

# ── Database (required) ──────────────────────────────────────────────────────
# Postgres connection string. Prisma reads this for both the client and the CLI.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# ── Auth (required) ──────────────────────────────────────────────────────────
# Signing secret for session tokens. Use a long random string, not a guessable one.
JWT_SECRET=""

# ── Angel One market data (required for Markets, charts and live quotes) ─────
# Without these the market endpoints fail and the Markets page shows a
# "not configured" banner. The rest of the app still runs.
# Credentials come from the Angel One SmartAPI dashboard; TOTP_SECRET is the
# base32 string behind the authenticator QR code, not a 6-digit code.
ANGELONE_API_KEY=""
ANGELONE_CLIENT_CODE=""
ANGELONE_MPIN=""
ANGELONE_TOTP_SECRET=""
# Optional — only set if Angel One has your outbound IP allow-listed.
# ANGELONE_CLIENT_PUBLIC_IP=""
# Optional — set to 1 to log raw Angel One request/response payloads.
# ANGELONE_DEBUG=""

# ── AI agents (optional) ─────────────────────────────────────────────────────
# Required only for the Financial AI Agents screens.
GEMINI_API_KEY=""

# ── Zerodha (optional) ───────────────────────────────────────────────────────
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""

# ── Branding / locale (optional — sensible defaults are built in) ────────────
# NEXT_PUBLIC_PLATFORM_NAME="Finuer"
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
# NEXT_PUBLIC_LOCALE="en-IN"
