{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/v1/cron?job=price-alerts",
      "schedule": "*/2 4-10 * * 1-5"
    },
    {
      "path": "/api/v1/cron?job=scheduled-posts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron?job=broadcasts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron?job=competitions",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/cron?job=subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron?job=finuer-pro",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/v1/cron?job=email-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/v1/cron?job=scrip-master",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/cron?job=fii-dii",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/v1/cron?job=bulk-deals",
      "schedule": "15,30,45 13 * * 1-5"
    }
  ]
}
